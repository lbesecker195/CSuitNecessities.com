en=&#34;true&#34;&gt;&lt;path d=&#34;M7 17 17 7M9 7h8v8&#34; fill=&#34;none&#34; stroke=&#34;currentColor&#34; stroke-width=&#34;2.5&#34; stroke-linecap=&#34;round&#34; stroke-linejoin=&#34;round&#34;/&gt;&lt;/svg&gt;&lt;/a&gt;.&lt;/p&gt;</description>
